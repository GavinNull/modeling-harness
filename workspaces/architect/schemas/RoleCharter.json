{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modeling-harness:schema:role-charter:1.0.0",
  "title": "RoleCharter",
  "description": "角色完成身份调研后提交、经主 Agent 冻结的职责和能力契约。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "charter_id",
    "role_id",
    "role_name",
    "charter_version",
    "phase",
    "mission",
    "responsibilities",
    "prohibited_actions",
    "input_contract",
    "output_contract",
    "capability_matrix",
    "source_ledger",
    "failure_catalog",
    "acceptance_tests",
    "tool_policy",
    "information_policy",
    "prompt_draft",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "charter_id": {
      "$ref": "#/$defs/identifier"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "role_name": {
      "type": "string",
      "minLength": 1
    },
    "charter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "phase": {
      "enum": [
        "governance",
        "definition",
        "understanding",
        "creation",
        "validation"
      ]
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "prohibited_actions": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "input_contract": {
      "$ref": "#/$defs/contract"
    },
    "output_contract": {
      "$ref": "#/$defs/contract"
    },
    "capability_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "description",
          "preconditions",
          "limits"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "source_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "source_type",
          "locator",
          "relevance",
          "verified_at"
        ],
        "properties": {
          "source_id": {
            "$ref": "#/$defs/identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "official-rule",
              "official-documentation",
              "primary-research",
              "textbook",
              "public-benchmark",
              "internal-standard"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "failure_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_id",
          "description",
          "detection",
          "mitigation"
        ],
        "properties": {
          "failure_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "detection": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 10,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "capability_tag",
          "procedure",
          "pass_condition"
        ],
        "properties": {
          "test_id": {
            "$ref": "#/$defs/identifier"
          },
          "capability_tag": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "pass_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "denied"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
          },
          "uniqueItems": true
        },
        "denied": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
          },
          "uniqueItems": true
        }
      }
    },
    "information_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_classes",
        "write_scope",
        "direct_peer_communication",
        "hidden_benchmark_access"
      ],
      "properties": {
        "read_classes": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "internal",
              "restricted",
              "benchmark-hidden"
            ]
          },
          "uniqueItems": true
        },
        "write_scope": {
          "type": "string",
          "pattern": "^/runs/\\{project\\}/\\{task_id\\}/[a-z][a-z0-9_]{1,63}/\\{attempt_id\\}/$"
        },
        "direct_peer_communication": {
          "const": false
        },
        "hidden_benchmark_access": {
          "type": "boolean"
        }
      }
    },
    "prompt_draft": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "charter_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "approved_by": {
          "oneOf": [
            {
              "const": "main_agent"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "charter_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "approved_by": {
                "const": "main_agent"
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "charter_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "schema_or_media_type",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "schema_or_media_type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
