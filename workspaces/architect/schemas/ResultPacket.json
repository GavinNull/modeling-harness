{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modeling-harness:schema:result-packet:1.0.0",
  "title": "ResultPacket",
  "description": "Subagent 对单个 TaskPacket 的结构化返回；不授予工件提升权限。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "task_id",
    "run_id",
    "attempt_id",
    "role_id",
    "task_packet_sha256",
    "status",
    "summary",
    "artifact_manifest",
    "claims_and_sources",
    "assumptions",
    "validation_performed",
    "metrics",
    "known_failures",
    "uncertainties",
    "provenance",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "packet_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "attempt_id": {
      "$ref": "#/$defs/identifier"
    },
    "role_id": {
      "$ref": "#/$defs/roleIdentifier"
    },
    "task_packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "artifact_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "manifest_sha256",
        "location"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "location": {
          "type": "string",
          "pattern": "^/runs/[a-zA-Z0-9_./-]+\\.json$"
        }
      }
    },
    "claims_and_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim",
          "source_refs",
          "support_type"
        ],
        "properties": {
          "claim_id": {
            "$ref": "#/$defs/identifier"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/sourceReference"
            }
          },
          "support_type": {
            "enum": [
              "data",
              "code-output",
              "derivation",
              "external-evidence",
              "assumption"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "statement",
          "justification",
          "impact_if_false"
        ],
        "properties": {
          "assumption_id": {
            "$ref": "#/$defs/identifier"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "impact_if_false": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation_performed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "validation_id",
          "method",
          "outcome",
          "evidence_ref"
        ],
        "properties": {
          "validation_id": {
            "$ref": "#/$defs/identifier"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          },
          "evidence_ref": {
            "$ref": "#/$defs/sourceReference"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "maxLength": 1000
          }
        ]
      }
    },
    "known_failures": {
      "$ref": "#/$defs/issueArray"
    },
    "uncertainties": {
      "$ref": "#/$defs/issueArray"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_sha256",
        "container_image_digest",
        "input_manifest_sha256s",
        "random_seeds"
      ],
      "properties": {
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "container_image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "input_manifest_sha256s": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true
        },
        "random_seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"
    },
    "roleIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_sha256",
        "locator"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issueArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "description",
          "impact"
        ],
        "properties": {
          "issue_id": {
            "$ref": "#/$defs/identifier"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    }
  }
}
