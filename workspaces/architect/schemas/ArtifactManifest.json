{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modeling-harness:schema:artifact-manifest:2.0.0",
  "title": "ArtifactManifest",
  "description": "内容寻址、可追溯且不可变的工件清单。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "task_id",
    "run_id",
    "attempt_id",
    "producer",
    "task_packet_sha256",
    "prompt_sha256",
    "container_image_digest",
    "source_provenance_sha256s",
    "real_task_derived",
    "input_manifest_sha256s",
    "artifacts",
    "promotion",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "manifest_id": {
      "$ref": "#/$defs/identifier"
    },
    "manifest_version": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "attempt_id": {
      "$ref": "#/$defs/identifier"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "workspace_id",
        "container_id"
      ],
      "properties": {
        "role_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "workspace_id": {
          "$ref": "#/$defs/identifier"
        },
        "container_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "task_packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "container_image_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "input_manifest_sha256s": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sha256"
      },
      "uniqueItems": true
    },
    "source_provenance_sha256s": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sha256"
      },
      "uniqueItems": true
    },
    "real_task_derived": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "logical_path",
          "content_sha256",
          "size_bytes",
          "media_type",
          "classification",
          "content_kind",
          "executable"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/identifier"
          },
          "logical_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"
          },
          "content_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "restricted",
              "benchmark-hidden"
            ]
          },
          "content_kind": {
            "enum": [
              "generic-core",
              "abstract-defect",
            "modification-admission",
              "direct-user-governance",
              "aggregate-regression",
              "content-independent-verification",
              "task-text",
              "task-attachment",
              "task-artifact",
              "evaluation-rubric",
              "raw-review",
              "score",
              "critique",
              "reference-solution",
              "test-failure",
              "benchmark-secret"
            ]
          },
          "executable": {
            "type": "boolean"
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "source_manifest_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "unsubmitted",
            "candidate",
            "promoted",
            "rejected",
            "quarantined"
          ]
        },
        "approved_by": {
          "oneOf": [
            {
              "const": "main_agent"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_manifest_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "promotion": {
            "properties": {
              "status": {
                "const": "promoted"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "promotion": {
            "properties": {
              "approved_by": {
                "const": "main_agent"
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_manifest_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
