{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modeling-harness:schema:source-provenance-manifest:1.0.0",
  "title": "SourceProvenanceManifest",
  "description": "Trusted-ingress, append-only source classification with monotonic real-task-derived taint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "subject_id",
    "source_class",
    "source_content_sha256",
    "parent_manifest_sha256s",
    "real_task_derived",
    "issued_by",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "$ref": "#/$defs/identifier"
    },
    "subject_id": {
      "$ref": "#/$defs/identifier"
    },
    "source_class": {
      "enum": [
        "public-real-task",
        "private-real-task",
        "synthetic-generic-test",
    "independent-general-research",
    "direct-user-governance-requirement"
      ]
    },
    "source_content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parent_manifest_sha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "real_task_derived": {
      "type": "boolean"
    },
    "issued_by": {
      "const": "trusted_provenance_ingress"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_class": {
            "enum": [
              "public-real-task",
              "private-real-task"
            ]
          }
        },
        "required": [
          "source_class"
        ]
      },
      "then": {
        "properties": {
          "real_task_derived": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
